{
  "name": "@livetrack/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical wire schema, codec and E2EE frame sealing for LiveTrackSuunto",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist src/gen .turbo"
  },
  "dependencies": {
    "protobufjs": "^8.7.2"
  },
  "devDependencies": {
    "protobufjs-cli": "^2.6.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
