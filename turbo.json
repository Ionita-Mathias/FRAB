{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "codegen": {
      "inputs": ["**/*.proto"],
      "outputs": ["src/gen/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["codegen"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
