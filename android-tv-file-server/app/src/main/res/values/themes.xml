<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A plain dark AppCompat theme rather than Theme.Leanback: the main screen is a fixed
         D-Pad layout, and the Leanback theme is only needed by the guided settings step. -->
    <style name="Theme.TvFileServer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/on_background</item>
        <item name="android:textColorSecondary">@color/on_background_muted</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.TvFileServer.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Widget.TvFileServer.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>
</resources>
