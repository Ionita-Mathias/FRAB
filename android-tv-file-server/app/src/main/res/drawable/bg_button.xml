<?xml version="1.0" encoding="utf-8"?>
<!-- The focused state must be unmistakable from across a room, so it changes fill, border
     and border width rather than relying on elevation alone. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="@dimen/card_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/on_background" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dark" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/card_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focused" />
            <corners android:radius="@dimen/card_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
        </shape>
    </item>
</selector>
